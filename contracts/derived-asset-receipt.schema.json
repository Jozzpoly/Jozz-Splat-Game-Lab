{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jozzpoly.github.io/Jozz-Splat-Game-Lab/contracts/derived-asset-receipt.schema.json",
  "title": "Splat Game Lab Derived Asset Receipt",
  "type": "object",
  "required": ["receiptVersion", "id", "inputs", "tool", "output", "evidenceStatus"],
  "properties": {
    "receiptVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sha256"],
        "properties": {
          "role": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "parameters": { "type": "object" },
    "scanToWorldVersion": { "type": ["string", "null"] },
    "output": {
      "type": "object",
      "required": ["sha256", "bytes"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "evidenceStatus": {
      "enum": ["GENERATED", "VERIFIED", "REJECTED", "MANUAL_PATCH"]
    }
  },
  "additionalProperties": true
}
