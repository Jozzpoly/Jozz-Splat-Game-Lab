{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jozzpoly.github.io/Jozz-Splat-Game-Lab/contracts/source-receipt.schema.json",
  "title": "Splat Game Lab Source Receipt",
  "type": "object",
  "required": ["receiptVersion", "id", "source"],
  "properties": {
    "receiptVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["sha256", "bytes"],
      "properties": {
        "name": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "provider": { "type": "string" },
        "redistributionLicense": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "observations": { "type": "object" }
  },
  "additionalProperties": true
}
